APP_ENV=development
APP_SECRET_KEY=change-this-demo-secret
AADHAAR_AES_KEY=0123456789abcdef0123456789abcdef
# Keep old key versions loaded until rotation has re-encrypted every record.
# AADHAAR_AES_KEYS=v1:0123456789abcdef0123456789abcdef,v2:replace-with-new-32-byte-key-value
AADHAAR_KEY_VERSION=v1
AADHAAR_KEY_PROVIDER=environment
AUDIT_HMAC_KEY=replace-with-a-separate-long-random-secret
STRICT_COMPLIANCE_MODE=false
# Mount separate append-only/WORM storage here:
# AUDIT_ARCHIVE_DIR=../audit-archive
# Authorized AUA/KUA/Sub-AUA provider adapter. Never point this at a normal SMS gateway.
# AADHAAR_AUTH_PROVIDER_URL=https://provider.example.com/aadhaar
# AADHAAR_AUTH_PROVIDER_KEY=provider-secret
# AADHAAR_AUTH_PROVIDER_NAME=Authorized provider name
# REQUIRE_VERIFIED_DISBURSAL=true
MONGO_URL=mongodb://localhost:27017/?directConnection=true
MONGO_DB=money_lending_demo
MONGO_ENABLED=false
ALLOW_MEMORY_FALLBACK=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required only on the first production startup:
# INITIAL_ADMIN_USERNAME=owner
# INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password
# INITIAL_ADMIN_NAME=Business Owner
# Required for encrypted backup files in production (exactly 32 random UTF-8 bytes):
# BACKUP_DIR=../backups
# BACKUP_ENCRYPTION_KEY=replace-with-random-32-byte-key
# Mount cloud/object storage locally and set this path for a second copy:
# OFFSITE_BACKUP_DIR=/mnt/offsite/money-lending-backups

# ---- OTP step in customer registration ----
# 1) No SMS account (default): leave SMS_PROVIDER empty. The OTP is shown on screen to the staff member (no SMS is sent).
# 2) Real SMS to the customer's phone with a free Android-phone gateway or any HTTP SMS service (SMS_PROVIDER=webhook):
#    take the URL, key and request format from your SMS service's documentation. {otp} {message} {mobile} {mobile_e164} {mobile_91}
#    are filled in automatically. Example shape (check your provider's docs - not verified against any live service):
# SMS_PROVIDER=webhook
# SMS_WEBHOOK_URL=https://api.example-sms-service.com/send
# SMS_WEBHOOK_HEADERS={"x-api-key":"YOUR_API_KEY"}
# SMS_WEBHOOK_BODY={"recipients":["{mobile_e164}"],"message":"{message}"}
# SMS_MESSAGE_TEMPLATE=Your OTP for Sri Sakthi Thirumurugan Finance registration is {otp}. It is valid for 5 minutes. Do not share it with anyone.
# 3) MSG91: SMS_PROVIDER=msg91 with MSG91_AUTH_KEY and MSG91_TEMPLATE_ID.
# Set SMS_OTP_REQUIRED=false to switch the OTP step off completely.
SMS_OTP_REQUIRED=true
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Separate secret used to hash OTPs (recommended in production):
# SMS_OTP_HMAC_KEY=replace-with-a-long-random-secret
