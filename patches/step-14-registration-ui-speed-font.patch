+
+/* Customer registration: aligned sections, no scattered boxes */
+.register-form { display: grid; gap: 18px; align-content: start; }
+.register-form label { margin: 0; }
+.register-form .form-intro { margin: 0; }
+.form-section { display: grid; gap: 14px; padding: 18px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); }
+.form-section-title { margin: 0; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
+.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 18px; align-items: start; }
+.form-grid .span-2 { grid-column: 1 / -1; }
+.register-form .check-row { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; color: var(--ink); font-size: 13px; font-weight: 600; cursor: pointer; }
+.register-form .check-row input[type="checkbox"] { flex: 0 0 20px; width: 20px; height: 20px; min-height: 0; padding: 0; margin: 0; accent-color: var(--accent); }
+.input-action { display: flex; gap: 8px; align-items: stretch; }
+.input-action input { flex: 1 1 auto; min-width: 0; }
+.input-action button, .input-action .otp-chip { flex: 0 0 auto; white-space: nowrap; align-self: center; }
+.otp-card { display: grid; gap: 12px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface-alt); }
+.otp-card.otp-verified { border-color: #86efac; background: #f0fdf4; }
+.otp-card .otp-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
+.otp-card .otp-title { display: grid; gap: 4px; }
+.otp-card .otp-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
+.otp-card .otp-row small { flex: 1 1 220px; }
+.otp-card .otp-input { flex: 0 0 170px; max-width: 170px; }
+.form-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 18px; padding-top: 4px; }
+.form-note { display: flex; align-items: center; gap: 8px; flex: 1 1 260px; color: var(--muted); font-size: 13px; }
+.form-footer .primary { min-width: 170px; }
+@media (max-width: 700px) { .form-grid { grid-template-columns: 1fr; } }
+/* Customers page: editor on top, form and registry side by side, no empty gaps */
+@media (min-width: 1101px) {
