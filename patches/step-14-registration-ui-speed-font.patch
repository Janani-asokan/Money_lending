+# Request-scoped preload for list screens: one query per collection instead of five queries for every loan.
+_LOAN_DATA: ContextVar[Optional[dict[str, Any]]] = ContextVar("loan_data_cache", default=None)
+
+
+async def build_loan_cache(raw_loans: list[dict[str, Any]]) -> dict[str, Any]:
+    def group(rows: list[dict[str, Any]]) -> dict[str, list[dict[str, Any]]]:
+        grouped: dict[str, list[dict[str, Any]]] = defaultdict(list)
+        for row in rows:
+            if row.get("status", "Posted") != "Reversed":
+                grouped[row["loan_id"]].append(row)
+        return grouped
+    payments = group(await find_many("payments"))
+    for rows in payments.values():
+        rows.sort(key=lambda payment: payment.get("timestamp", ""))
+    needed = {(loan["loan_id"], int(loan.get("schedule_version", 1))) for loan in raw_loans}
+    schedules: dict[tuple[str, int], dict[str, Any]] = {}
+    for doc in await find_many("loan_schedules"):
+        key = (doc["loan_id"], int(doc.get("version", 1)))
+        if key in needed:
+            schedules[key] = doc
+    return {
+        "payments": payments, "adjustments": group(await find_many("loan_adjustments")),
+        "part_payments": group(await find_many("part_payments")), "writeoffs": group(await find_many("writeoffs")),
+        "schedules": schedules,
+    }
+
+
+async def enrich_all(raw_loans: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """enrich_loan for many loans using a handful of queries in total (fast for the Loan book, dashboards and reports)."""
+    if not raw_loans:
+        return []
+    token = _LOAN_DATA.set(await build_loan_cache(raw_loans))
+    try:
+        return [await enrich_loan(loan) for loan in raw_loans]
+    finally:
+        _LOAN_DATA.reset(token)
+
