+// Shared customer lookup used by Customer Onboarding and Loan disbursement (same rule, same list).
+function findCustomerMatches(customers, nameText, mobileText) {
+  const name = (nameText || '').trim().toLowerCase();
+  const mobile = (mobileText || '').trim();
+  if (name.length < 3 && mobile.length < 4) return [];
+  return customers.filter(customer =>
+    (mobile.length >= 4 && customer.mobile?.includes(mobile)) ||
+    (name.length >= 3 && customer.name?.toLowerCase().includes(name))
+  ).slice(0, 4);
+}
+
+function CustomerSuggestions({ matches, onSelect }) {
+  if (!matches.length) return null;
+  return <div className="customer-suggestions" role="listbox" aria-label="Existing customer suggestions"><strong>Existing customer found</strong><small>Select the previous profile instead of creating a duplicate.</small>{matches.map(customer => <button type="button" key={customer.customer_id} onClick={() => onSelect(customer)}><span>{customer.name}<small>{customer.customer_id} · {customer.mobile}</small></span><ChevronRight size={17}/></button>)}</div>;
+}
+
+function CustomerPicker({ customers, value, onChange }) {
+  const [name, setName] = useState('');
+  const [mobile, setMobile] = useState('');
+  const matches = useMemo(() => findCustomerMatches(customers, name, mobile), [customers, name, mobile]);
+  const selected = customers.find(c => c.customer_id === value);
+  function pick(customer) {
+    setName(customer.name || '');
+    setMobile(customer.mobile || '');
+    onChange(customer.customer_id);
+  }
+  return (
+    <div className="customer-picker">
+      <div className="two-col">
+        <label>Customer name<input value={name} onChange={e => setName(e.target.value)} placeholder="Type 3+ letters" /></label>
+        <label>Mobile<input inputMode="numeric" maxLength="10" value={mobile} onChange={e => setMobile(e.target.value.replace(/\D/g, ''))} placeholder="Type 4+ digits" /></label>
+      </div>
+      <CustomerSuggestions matches={matches} onSelect={pick} />
+      {selected
+        ? <div className="locked-note"><CheckCircle2 size={16} /> Selected: <strong>{selected.name}</strong> · {selected.customer_id} · {selected.mobile} · {selected.status}</div>
+        : <div className="locked-note"><AlertTriangle size={16} /> No customer selected. Type a name or mobile number and choose from the list.</div>}
+    </div>
+  );
+}
