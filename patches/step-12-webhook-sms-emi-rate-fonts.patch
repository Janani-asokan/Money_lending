+def _webhook_send_blocking(mobile: str, otp: str) -> Optional[str]:
+    """Send the OTP through any HTTP SMS service described by the SMS_WEBHOOK_* settings."""
+    import urllib.error
+    import urllib.request
+    values = {"{otp}": otp, "{message}": SMS_MESSAGE_TEMPLATE.replace("{otp}", otp), "{mobile_e164}": "+91" + mobile, "{mobile_91}": "91" + mobile, "{mobile}": mobile}
+
+    def fill(node: Any) -> Any:
+        if isinstance(node, str):
+            for key, value in values.items():
+                node = node.replace(key, value)
+            return node
+        if isinstance(node, list):
+            return [fill(item) for item in node]
+        if isinstance(node, dict):
+            return {key: fill(value) for key, value in node.items()}
+        return node
+
+    try:
+        body = fill(json.loads(SMS_WEBHOOK_BODY))
+        extra_headers = json.loads(SMS_WEBHOOK_HEADERS) if SMS_WEBHOOK_HEADERS else {}
+        if not isinstance(extra_headers, dict):
+            raise ValueError("headers must be a JSON object")
+    except ValueError as exc:
+        print(f"[sms-otp] SMS_WEBHOOK_BODY / SMS_WEBHOOK_HEADERS are not valid JSON: {exc}")
+        raise HTTPException(500, "The SMS settings on the server are not valid JSON. Ask the administrator to fix SMS_WEBHOOK_BODY / SMS_WEBHOOK_HEADERS.") from exc
+    headers = {"Content-Type": "application/json", "Accept": "application/json", **{str(key): str(value) for key, value in extra_headers.items()}}
+    request = urllib.request.Request(SMS_WEBHOOK_URL, data=json.dumps(body).encode("utf-8"), method="POST", headers=headers)
+    try:
+        with urllib.request.urlopen(request, timeout=15) as response:
+            raw = response.read().decode("utf-8", "ignore")
+    except urllib.error.HTTPError as exc:
+        print(f"[sms-otp] SMS service answered HTTP {exc.code}")
+        raise HTTPException(502, "The SMS service did not accept the message. Check its settings, key and balance.") from exc
+    except (urllib.error.URLError, TimeoutError) as exc:
+        print(f"[sms-otp] SMS service call failed: {type(exc).__name__}")
+        raise HTTPException(502, "The SMS could not be sent. Check the SMS service and try again.") from exc
+    try:
+        data = json.loads(raw) if raw.strip() else {}
+    except ValueError:
+        data = {}
+    if isinstance(data, dict):
+        inner = data.get("data") if isinstance(data.get("data"), dict) else {}
+        for source in (data, inner):
+            for key in ("message_id", "messageId", "id", "request_id", "smsBatchId", "_id"):
+                if source.get(key):
+                    return str(source[key])[:120]
+    return None
+
