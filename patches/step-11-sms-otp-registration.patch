+def sms_otp_hash(otp_id: str, mobile: str, otp: str) -> str:
+    # The OTP is never stored or logged in clear text; only this keyed hash (bound to the OTP id and the mobile number).
+    return hmac.new(SMS_OTP_HMAC_KEY, f"{otp_id}:{mobile}:{otp}".encode(), hashlib.sha256).hexdigest()
+
+
+def mask_mobile(mobile: str) -> str:
+    return "XXXXXX" + mobile[-4:]
+
+
+def _msg91_send_blocking(mobile: str, otp: str) -> Optional[str]:
+    """Send the OTP through MSG91's OTP API. Only this function knows the gateway's request format."""
+    import urllib.error
+    import urllib.parse
+    import urllib.request
+    query = urllib.parse.urlencode({
+        "template_id": MSG91_TEMPLATE_ID, "mobile": "91" + mobile, "authkey": MSG91_AUTH_KEY,
+        "otp": otp, "otp_expiry": max(SMS_OTP_EXPIRY_SECONDS // 60, 1),
+    })
+    request = urllib.request.Request(
+        "https://control.msg91.com/api/v5/otp?" + query, data=b"{}", method="POST",
+        headers={"Content-Type": "application/json", "Accept": "application/json", "authkey": MSG91_AUTH_KEY},
+    )
+    try:
+        with urllib.request.urlopen(request, timeout=10) as response:
+            body = json.loads(response.read().decode("utf-8") or "{}")
+    except (urllib.error.URLError, TimeoutError, ValueError) as exc:
+        print(f"[sms-otp] gateway call failed: {type(exc).__name__}")
+        raise HTTPException(502, "The SMS could not be sent. Please try again in a moment.") from exc
+    if str(body.get("type", "")).lower() != "success":
+        print(f"[sms-otp] gateway rejected the request: {str(body.get('message', ''))[:120]}")
+        raise HTTPException(502, "The SMS gateway did not accept the message. Check the MSG91 template and balance.")
+    return str(body.get("message") or body.get("request_id") or "") or None
+
+
+async def deliver_sms_otp(mobile: str, otp: str) -> dict[str, Any]:
+    if SMS_PROVIDER_CONFIGURED:
+        message_id = await asyncio.to_thread(_msg91_send_blocking, mobile, otp)
+        return {"gateway": "msg91", "gateway_message_id": message_id}
+    print(f"[sms-otp ON-SCREEN MODE] OTP for {mobile}: {otp}")
+    return {"gateway": "screen", "gateway_message_id": None}
+
+
+async def sms_sends_in_last_hour(mobile: str) -> int:
+    cutoff = now() - timedelta(hours=1)
+    return sum(1 for record in await find_many("sms_otps", {"mobile": mobile}) for stamp in record.get("send_timestamps", []) if parse_date(stamp) >= cutoff)
+
+
+def sms_otp_public(record: dict[str, Any], dev_otp: Optional[str] = None) -> dict[str, Any]:
+    stamp = now()
+    result = {
+        "otp_id": record["otp_id"], "status": record["status"], "mobile_masked": mask_mobile(record["mobile"]),
+        "expires_at": record["expires_at"], "expires_in_seconds": max(int((parse_date(record["expires_at"]) - stamp).total_seconds()), 0),
+        "resend_available_at": iso(parse_date(record["last_sent_at"]) + timedelta(seconds=SMS_OTP_RESEND_GAP_SECONDS)),
+        "resends_remaining": max(SMS_OTP_MAX_RESENDS - int(record.get("resend_count", 0)), 0),
+        "attempts_remaining": max(SMS_OTP_MAX_ATTEMPTS - int(record.get("attempt_count", 0)), 0),
+        "development_mode": record.get("gateway") == "screen",
+    }
+    if dev_otp and record.get("gateway") == "screen":
+        result["dev_otp"] = dev_otp
+    return result
+
+
+async def sms_otp_update(record: dict[str, Any], fields: dict[str, Any], expected_status: str) -> bool:
+    """Apply `fields` only if the OTP still has the status and attempt count we read (stops double use and races)."""
+    if USE_MEMORY:
+        current = await find_one("sms_otps", {"otp_id": record["otp_id"]})
+        if not current or current.get("status") != expected_status or int(current.get("attempt_count", 0)) != int(record.get("attempt_count", 0)):
+            return False
+        await replace_one("sms_otps", {"otp_id": record["otp_id"]}, {**current, **fields})
+        return True
+    result = await db.sms_otps.update_one({"otp_id": record["otp_id"], "status": expected_status, "attempt_count": int(record.get("attempt_count", 0))}, {"$set": fields})
+    return result.modified_count == 1
+
+
+async def require_verified_sms_otp(otp_id: Optional[str], mobile: str) -> dict[str, Any]:
+    if not otp_id:
+        raise HTTPException(422, "Verify the customer's mobile number with an SMS OTP before registering.")
+    record = await find_one("sms_otps", {"otp_id": otp_id})
+    if not record or record.get("purpose") != "registration" or record.get("mobile") != mobile:
+        raise HTTPException(422, "The SMS OTP does not belong to this mobile number. Send and verify a new OTP.")
+    if record.get("status") == "Consumed":
+        raise HTTPException(422, "This OTP was already used for a registration. Send a new OTP.")
+    if record.get("status") != "Verified":
+        raise HTTPException(422, "Verify the SMS OTP sent to this mobile number before registering.")
+    if parse_date(record["verified_at"]) + timedelta(seconds=SMS_OTP_VERIFIED_VALID_SECONDS) < now():
+        raise HTTPException(422, "The OTP verification expired. Send a new OTP.")
+    return record
+
+
+@app.get("/api/otp/sms/status")
+async def sms_otp_status(user: dict[str, Any] = Depends(require("owner", "manager"))) -> dict[str, Any]:
+    return {
+        "required": SMS_OTP_REQUIRED, "configured": SMS_PROVIDER_CONFIGURED, "development_mode": SMS_ON_SCREEN_MODE,
+        "expiry_seconds": SMS_OTP_EXPIRY_SECONDS, "max_attempts": SMS_OTP_MAX_ATTEMPTS,
+        "max_resends": SMS_OTP_MAX_RESENDS, "resend_gap_seconds": SMS_OTP_RESEND_GAP_SECONDS,
+    }
+
+
+@app.post("/api/otp/sms/send")
+async def send_sms_otp(payload: SmsOtpSendIn, request: Request, user: dict[str, Any] = Depends(require("owner", "manager"))) -> dict[str, Any]:
+    existing = await find_one("customers", {"mobile": payload.mobile})
+    if existing:
+        raise HTTPException(409, f"A customer with this mobile number already exists ({existing['customer_id']}). Select the existing profile instead.")
+    if await sms_sends_in_last_hour(payload.mobile) >= SMS_OTP_MAX_PER_HOUR:
+        raise HTTPException(429, f"Too many OTP messages were sent to this number. Try again after an hour (limit {SMS_OTP_MAX_PER_HOUR} per hour).")
+    otp = "".join(secrets.choice("0123456789") for _ in range(SMS_OTP_LENGTH))
+    otp_id = f"SOT-{await next_sequence('SOT', 'otp_id', 'sms_otps'):09d}"
+    delivery = await deliver_sms_otp(payload.mobile, otp)
+    stamp = now()
+    record = {
+        "otp_id": otp_id, "purpose": payload.purpose, "mobile": payload.mobile, "otp_hash": sms_otp_hash(otp_id, payload.mobile, otp),
+        "status": "Sent", "created_at": iso(stamp), "last_sent_at": iso(stamp), "expires_at": iso(stamp + timedelta(seconds=SMS_OTP_EXPIRY_SECONDS)),
+        "send_timestamps": [iso(stamp)], "resend_count": 0, "attempt_count": 0,
+        "gateway": delivery["gateway"], "gateway_message_ids": [delivery["gateway_message_id"]] if delivery["gateway_message_id"] else [],
+        "requested_by": user["name"], "requested_by_id": user["id"],
+    }
+    for older in await find_many("sms_otps", {"mobile": payload.mobile, "purpose": payload.purpose}):
+        if older.get("status") in {"Sent", "Verified"}:
+            await sms_otp_update(older, {"status": "Cancelled", "cancelled_at": iso(stamp)}, older["status"])
+    await insert_one("sms_otps", record)
+    await audit(user, "sms_otp_sent", "sms_otp", otp_id, {"mobile": mask_mobile(payload.mobile), "purpose": payload.purpose, "gateway": delivery["gateway"], "gateway_message_id": delivery["gateway_message_id"]}, request)
+    return sms_otp_public(record, dev_otp=otp)
+
+
+@app.post("/api/otp/sms/resend")
+async def resend_sms_otp(payload: SmsOtpResendIn, request: Request, user: dict[str, Any] = Depends(require("owner", "manager"))) -> dict[str, Any]:
+    record = await find_one("sms_otps", {"otp_id": payload.otp_id})
+    if not record:
+        raise HTTPException(404, "OTP request not found")
+    if record.get("status") != "Sent":
+        raise HTTPException(409, "This OTP can no longer be resent. Send a new OTP.")
+    stamp = now()
+    if parse_date(record["expires_at"]) <= stamp:
+        await sms_otp_update(record, {"status": "Expired", "completed_at": iso(stamp)}, "Sent")
+        raise HTTPException(410, "OTP expired. Send a new OTP.")
+    if int(record.get("resend_count", 0)) >= SMS_OTP_MAX_RESENDS:
+        raise HTTPException(429, f"Resend limit reached ({SMS_OTP_MAX_RESENDS}). Wait for the OTP to expire, then send a new one.")
+    wait = SMS_OTP_RESEND_GAP_SECONDS - int((stamp - parse_date(record["last_sent_at"])).total_seconds())
+    if wait > 0:
+        raise HTTPException(429, f"Wait {wait} more second{'s' if wait != 1 else ''} before resending.")
+    if await sms_sends_in_last_hour(record["mobile"]) >= SMS_OTP_MAX_PER_HOUR:
+        raise HTTPException(429, f"Too many OTP messages were sent to this number. Try again after an hour (limit {SMS_OTP_MAX_PER_HOUR} per hour).")
+    otp = "".join(secrets.choice("0123456789") for _ in range(SMS_OTP_LENGTH))
+    delivery = await deliver_sms_otp(record["mobile"], otp)
+    stamp = now()
+    fields = {
+        "otp_hash": sms_otp_hash(record["otp_id"], record["mobile"], otp), "last_sent_at": iso(stamp),
+        "expires_at": iso(stamp + timedelta(seconds=SMS_OTP_EXPIRY_SECONDS)), "resend_count": int(record.get("resend_count", 0)) + 1,
+        "send_timestamps": [*record.get("send_timestamps", []), iso(stamp)], "attempt_count": 0, "gateway": delivery["gateway"],
+        "gateway_message_ids": [*record.get("gateway_message_ids", []), *([delivery["gateway_message_id"]] if delivery["gateway_message_id"] else [])],
+    }
+    if not await sms_otp_update(record, fields, "Sent"):
+        raise HTTPException(409, "OTP state changed. Please try again.")
+    await audit(user, "sms_otp_resent", "sms_otp", record["otp_id"], {"mobile": mask_mobile(record["mobile"]), "resend_number": fields["resend_count"], "gateway": delivery["gateway"], "gateway_message_id": delivery["gateway_message_id"]}, request)
+    return sms_otp_public({**record, **fields}, dev_otp=otp)
+
+
+@app.post("/api/otp/sms/verify")
+async def verify_sms_otp(payload: SmsOtpVerifyIn, request: Request, user: dict[str, Any] = Depends(require("owner", "manager"))) -> dict[str, Any]:
+    record = await find_one("sms_otps", {"otp_id": payload.otp_id})
+    if not record:
+        raise HTTPException(404, "OTP request not found")
+    if record.get("status") == "Verified":
+        return {**sms_otp_public(record), "verified": True, "verified_at": record["verified_at"]}
+    if record.get("status") != "Sent":
+        raise HTTPException(409, "This OTP is no longer valid. Send a new OTP.")
+    stamp = now()
+    if parse_date(record["expires_at"]) <= stamp:
+        await sms_otp_update(record, {"status": "Expired", "completed_at": iso(stamp)}, "Sent")
+        raise HTTPException(410, "OTP expired. Send a new OTP.")
+    if not hmac.compare_digest(record["otp_hash"], sms_otp_hash(record["otp_id"], record["mobile"], payload.otp)):
+        attempts = int(record.get("attempt_count", 0)) + 1
+        remaining = max(SMS_OTP_MAX_ATTEMPTS - attempts, 0)
+        fields: dict[str, Any] = {"attempt_count": attempts, "last_failed_at": iso(stamp)}
+        if remaining == 0:
+            fields["status"] = "Locked"
+        if not await sms_otp_update(record, fields, "Sent"):
+            raise HTTPException(409, "OTP state changed. Please try again.")
+        await audit(user, "sms_otp_failed", "sms_otp", record["otp_id"], {"mobile": mask_mobile(record["mobile"]), "attempt_number": attempts, "attempts_remaining": remaining}, request)
+        if remaining == 0:
+            raise HTTPException(423, f"OTP locked after {SMS_OTP_MAX_ATTEMPTS} incorrect attempts. Send a new OTP.")
+        raise HTTPException(422, f"Incorrect OTP. {remaining} attempt{'s' if remaining != 1 else ''} remaining.")
+    fields = {"status": "Verified", "verified_at": iso(stamp), "verified_by": user["name"], "verified_by_id": user["id"]}
+    if not await sms_otp_update(record, fields, "Sent"):
+        raise HTTPException(409, "OTP state changed. Please try again.")
+    await audit(user, "sms_otp_verified", "sms_otp", record["otp_id"], {"mobile": mask_mobile(record["mobile"]), "purpose": record["purpose"]}, request)
+    return {**sms_otp_public({**record, **fields}), "verified": True, "verified_at": fields["verified_at"]}
+
