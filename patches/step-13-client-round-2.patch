+.link-button:hover { filter: brightness(.85); }
+.loan-filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; align-items: end; margin: 6px 0 12px; }
+.loan-filters label { margin: 0; }
