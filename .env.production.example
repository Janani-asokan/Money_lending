# Copy to .env.production and replace every CHANGE_ME value.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD
MONGO_DATABASE=money_lending_production
MONGO_APP_USERNAME=money_lending_app
MONGO_APP_PASSWORD=CHANGE_ME_LONG_RANDOM_APP_PASSWORD
MONGO_REPLICA_KEY=CHANGE_ME_RANDOM_REPLICA_KEY_AT_LEAST_32_CHARACTERS

# Backend settings (copy the relevant values into server/.env).
APP_ENV=production
APP_SECRET_KEY=CHANGE_ME_RANDOM_64_CHARACTER_APPLICATION_SECRET
AADHAAR_AES_KEY=change-this-32-byte-key-12345678
MONGO_ENABLED=true
MONGO_URL=mongodb://money_lending_app:CHANGE_ME_LONG_RANDOM_APP_PASSWORD@127.0.0.1:27017/money_lending_production?authSource=money_lending_production&replicaSet=rs0&directConnection=true&w=majority&journal=true&retryWrites=true
MONGO_DB=money_lending_production
ALLOW_MEMORY_FALLBACK=false
CORS_ORIGINS=https://finance.example.com
APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8080
